# Токен бота от @BotFather. Это ОТДЕЛЬНЫЙ бот — создай второго через /newbot.
BOT_TOKEN=сюда_вставь_токен

# Твой Telegram ID — бот будет отвечать только тебе.
# Узнать: запусти бота и нажми /start — он пришлёт твой ID.
OWNER_IDS=

# Cookies из браузера. Нужны для YouTube (бот-чек) и Instagram (логин).
# Впиши браузер, где ты залогинен: chrome / safari / firefox
COOKIES_FROM_BROWSER=chrome
# Или путь к файлу cookies.txt (вместо строки выше):
COOKIES_FILE=
